{"$schema":"https://json-schema.org/draft/2020-12/schema","description":"Each finding carries a `classification`: `CONFIRMED` means the reviewer verified it against the code, `REJECTED_WITH_REASON` means it was checked and does not hold, `NEEDS_CLARIFICATION` means nobody has established either yet. An unclassified finding is what let a suggestion be implemented without verification, so the field is required and the two non-confirmed values require a `disposition_reason`. A `REJECTED_WITH_REASON` finding may not be `blocking`, and an `ACCEPT` verdict over a `NEEDS_CLARIFICATION` finding is inconsistent: the question has to be answered first.","type":"object","required":["task_id","change_set_hash","baseline_revisions","axes","findings","verdict","provider","completeness_state"],"properties":{"task_id":{"type":"string","minLength":1},"change_set_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"baseline_revisions":{"$ref":"#/$defs/revisions"},"axes":{"type":"object","required":["standards","spec"],"properties":{"standards":{"$ref":"#/$defs/axis"},"spec":{"$ref":"#/$defs/axis"}},"additionalProperties":false},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"verdict":{"type":"string","enum":["ACCEPT","REJECT","INCOMPLETE"]},"provider":{"type":"object","required":["kind","identity"],"properties":{"kind":{"type":"string","minLength":1},"identity":{"type":"string","minLength":1}},"additionalProperties":false},"completeness_state":{"type":"string","enum":["COMPLETE","INCOMPLETE"]}},"$defs":{"revisions":{"type":"object","required":["business","tests"],"properties":{"business":{"type":"string","minLength":1},"tests":{"type":"string","minLength":1}},"additionalProperties":false},"axis":{"type":"object","required":["complete","finding_ids"],"properties":{"complete":{"type":"boolean"},"finding_ids":{"type":"array","items":{"type":"string","minLength":1}}},"additionalProperties":false},"finding":{"type":"object","required":["id","axis","severity","location","evidence","acceptance_point_ids","blocking","classification"],"properties":{"id":{"type":"string","minLength":1},"axis":{"type":"string","enum":["standards","spec"]},"severity":{"type":"string","enum":["P0","P1","P2","P3"]},"location":{"type":"string","minLength":1},"evidence":{"type":"string","minLength":1},"acceptance_point_ids":{"type":"array","items":{"type":"string","minLength":1}},"blocking":{"type":"boolean"},"classification":{"type":"string","enum":["CONFIRMED","REJECTED_WITH_REASON","NEEDS_CLARIFICATION"]},"disposition_reason":{"type":"string","minLength":1}},"additionalProperties":false}},"additionalProperties":false}
