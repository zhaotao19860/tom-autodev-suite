{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "run_id",
        "job_id",
        "action_id",
        "source_event_id",
        "task_id",
        "input_hash",
        "plan_artifact_id",
        "plan_content_hash",
        "plan_approval_id",
        "plan_approval_input_hash",
        "source_revisions",
        "reason",
        "evidence",
        "workspace_state"
    ],
    "properties": {
        "run_id": {
            "type": "string",
            "minLength": 1
        },
        "job_id": {
            "type": "string",
            "minLength": 1
        },
        "action_id": {
            "type": "string",
            "minLength": 1
        },
        "source_event_id": {
            "type": "string",
            "minLength": 1
        },
        "task_id": {
            "type": "string",
            "minLength": 1
        },
        "input_hash": {
            "type": "string",
            "minLength": 1
        },
        "plan_artifact_id": {
            "type": "string",
            "minLength": 1
        },
        "plan_content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "plan_approval_id": {
            "type": "string",
            "minLength": 1
        },
        "plan_approval_input_hash": {
            "type": "string",
            "minLength": 1
        },
        "source_revisions": {
            "type": "object",
            "required": [
                "business",
                "tests"
            ],
            "properties": {
                "business": {
                    "type": "string",
                    "minLength": 1
                },
                "tests": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "reason": {
            "type": "string",
            "minLength": 1
        },
        "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "classification": {
            "type": "string",
            "enum": [
                "USER_REQUIREMENT_CHANGED",
                "CONTRACT_INPUT_MISSING"
            ]
        },
        "workspace_state": {
            "type": "string",
            "enum": [
                "NO_CODE_CHANGES"
            ]
        }
    },
    "additionalProperties": false
}
