{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","required":["task_id","attempt","frozen_revisions","build_id","stage_id","job_id","environment_fingerprint","log_evidence","classification","reproduction","comparison","hypothesis","minimal_verification","route","repair_direction","repair_plan","repair_diff_hash","failure_signature","evidence_state"],"properties":{"task_id":{"type":["string","null"]},"attempt":{"type":"integer","minimum":1},"frozen_revisions":{"$ref":"#/$defs/revisions"},"build_id":{"type":"string","minLength":1},"stage_id":{"type":"string","minLength":1},"job_id":{"type":"string","minLength":1},"environment_fingerprint":{"type":"string","minLength":1},"log_evidence":{"$ref":"#/$defs/strings"},"classification":{"type":"string","minLength":1},"reproduction":{"$ref":"#/$defs/strings"},"comparison":{"$ref":"#/$defs/strings"},"hypothesis":{"type":["string","null"]},"minimal_verification":{"$ref":"#/$defs/strings"},"route":{"type":"string","enum":["REPAIR","SPEC","ARCHITECTURE_REVIEW","STOPPED","DIAGNOSIS_INCOMPLETE"]},"repair_direction":{"type":["string","null"]},"repair_plan":{"type":"array","items":{"type":"string","minLength":1}},"repair_diff_hash":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"failure_signature":{"type":"string","minLength":1},"evidence_state":{"type":"string","enum":["SUFFICIENT","INSUFFICIENT"]}},"$defs":{"strings":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"revisions":{"type":"object","required":["business","tests"],"properties":{"business":{"type":"string","minLength":1},"tests":{"type":"string","minLength":1}},"additionalProperties":false}},"additionalProperties":false}
